# Example:
# PORTAL_OPS_TARGETS_JSON=[{"id":"invoiceplane-demo","label":"InvoicePlane Demo","baseUrl":"https://demo.invoiceplane.com","username":"guest@invoiceplane.com","password":"demopassword","invoicesPath":"/invoices/index","resultLimit":5}]
